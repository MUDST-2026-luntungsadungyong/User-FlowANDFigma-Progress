flowchart TD
    subgraph Seller
        start([Start]) --> viewDash[Open Seller Dashboard]
        viewDash --> inputCost[Input or Update Card Cost per item]
        inputCost --> saveCost[Save Cost]
        viewDash --> viewProfit[View Estimated Sales and Profit]
    end
    
    subgraph System
        saveCost -.-> dbCost[Update Cost in DB]
        viewProfit -.-> calc["Calculate Profit: (Price - Cost) * Qty"]
        calc -.-> retProfit[Return Dashboard Metrics]
    end
